{%- doc -%}
  Zustandshinweis auf der Produktseite. Erscheint nur, wenn der Artikel nicht "neu, original verpackt" ist.
  Quelle: Metafeld mahando.zustand (verpackung-beschaedigt | b-ware | refurbished | auslaufmodell) oder gleichnamige Tags.
  Der Erklärtext kommt aus dem Metafeld mahando.zustand_hinweis, sonst aus dem Standardtext je Zustand.
  Im Theme-Editor wird ohne Zustand eine Vorschau angezeigt, damit der Block platzierbar bleibt.
{%- enddoc -%}

{%- liquid
  assign product = closest.product
  capture zustand
    render 'mahando-zustand', product: product
  endcapture
  assign zustand = zustand | strip

  assign title = ''
  assign note = product.metafields.mahando.zustand_hinweis | strip
  case zustand
    when 'verpackung-beschaedigt'
      assign title = 'mahando.condition.packaging_damaged' | t
      if note == blank
        assign note = 'mahando.condition.default_note_packaging' | t
      endif
    when 'b-ware'
      assign title = 'mahando.condition.b_ware' | t
      if note == blank
        assign note = 'mahando.condition.default_note_b_ware' | t
      endif
    when 'refurbished'
      assign title = 'mahando.condition.refurbished' | t
      if note == blank
        assign note = 'mahando.condition.default_note_refurbished' | t
      endif
    when 'auslaufmodell'
      assign title = 'mahando.condition.discontinued' | t
      if note == blank
        assign note = 'mahando.condition.default_note_discontinued' | t
      endif
  endcase

  assign is_preview = false
  if title == blank and request.design_mode
    assign is_preview = true
    assign title = 'mahando.condition.packaging_damaged' | t
    assign note = 'Vorschau im Theme-Editor: Dieser Hinweis erscheint im Shop nur bei Artikeln mit Zustand „Verpackung beschädigt“, „B-Ware“, „Refurbished“ oder „Auslaufmodell“.'
  endif
-%}

{%- if title != blank -%}
  <div
    class="mahando-condition spacing-style{% if is_preview %} mahando-condition--preview{% endif %}"
    style="{% render 'spacing-style', settings: block.settings %}"
    role="note"
    {{ block.shopify_attributes }}
  >
    {% render 'mahando-icon', icon: 'info', class: 'mahando-condition__icon' %}
    <div class="mahando-condition__body">
      <strong class="mahando-condition__title">{{ 'mahando.condition.label' | t }}: {{ title }}</strong>
      {%- if note != blank -%}
        <p class="mahando-condition__text">{{ note }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .mahando-condition {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    background: #fdf1dc;
    color: #34454e;
    border-radius: 10px;
    padding: 12px 14px;
    font-size: var(--font-size--sm);
    line-height: 1.45;
  }

  .mahando-condition__icon {
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 1px;
    color: #8a5306;
  }

  .mahando-condition__title {
    display: block;
    color: #8a5306;
    font-weight: 600;
  }

  .mahando-condition__text {
    margin: 2px 0 0;
  }

  .mahando-condition--preview {
    outline: 1px dashed #8a5306;
  }
{% endstylesheet %}

