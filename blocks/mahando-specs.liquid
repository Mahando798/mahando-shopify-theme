{%- doc -%}
  Technische Daten als zweispaltige Faktenliste.
  Quelle: Metafeld mahando.technische_daten (mehrzeiliger Text), eine Zeile pro Eintrag im Format
  "Bezeichnung: Wert", z. B. "Spannung: 20 V".
{%- enddoc -%}

{%- liquid
  assign product = closest.product
  assign raw = product.metafields.mahando.technische_daten | strip
  assign lines = raw | newline_to_br | split: '<br />'
  assign rows = ''
  for line in lines
    assign clean = line | strip_html | strip
    assign first_char = clean | slice: 0
    if first_char == '#'
      assign rows = rows | append: clean | append: '||'
    elsif clean contains ':'
      assign rows = rows | append: clean | append: '||'
    endif
  endfor
  assign rows = rows | split: '||'
-%}

{%- if rows.size > 0 -%}
  <div
    class="mahando-specs spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.heading != blank -%}
      <h3 class="mahando-specs__heading h6">{{ block.settings.heading }}</h3>
    {%- endif -%}
    {%- if block.settings.style == 'zebra' -%}
      <div class="mahando-specs__zebra">
        {%- assign zi = 0 -%}
        {%- for row in rows limit: block.settings.max_rows -%}
          {%- assign first_char = row | slice: 0 -%}
          {%- if first_char == '#' -%}
            <h4 class="mahando-specs__group">{{ row | remove: '#' | strip }}</h4>
            {%- assign zi = 0 -%}
          {%- else -%}
            {%- assign parts = row | split: ':' -%}
            {%- assign zi = zi | plus: 1 -%}
            <div class="mahando-specs__zrow{% assign zm = zi | modulo: 2 %}{% if zm == 1 %} is-odd{% endif %}">
              <span class="mahando-specs__k">{{ parts[0] | strip }}</span>
              <span class="mahando-specs__v">{{ row | remove_first: parts[0] | remove_first: ':' | strip }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
    <dl class="mahando-specs__list mahando-specs__list--{{ block.settings.columns }}">
      {%- for row in rows limit: block.settings.max_rows -%}
        {%- assign first_char = row | slice: 0 -%}
        {%- if first_char == '#' -%}{%- continue -%}{%- endif -%}
        {%- assign parts = row | split: ':' -%}
        {%- assign label = parts[0] | strip -%}
        {%- assign value = row | remove_first: parts[0] | remove_first: ':' | strip -%}
        <div class="mahando-specs__row">
          <dt>{{ label }}</dt>
          <dd>{{ value }}</dd>
        </div>
      {%- endfor -%}
    </dl>
    {%- endif -%}
  </div>
{%- elsif request.design_mode -%}
  <div class="mahando-specs mahando-specs--empty" {{ block.shopify_attributes }}>
    <p class="mahando-specs__hint">Technische Daten: Metafeld „mahando.technische_daten“ ist bei diesem Produkt leer. Format: eine Zeile je Eintrag, z. B. „Spannung: 20 V“.</p>
  </div>
{%- endif -%}

{% stylesheet %}
  .mahando-specs__heading {
    margin: 0 0 8px;
  }

  .mahando-specs__list {
    margin: 0;
    display: grid;
    gap: 2px 20px;
    background: var(--mahando-surface, #fff);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 10px 16px;
    font-size: var(--font-size--sm);
  }

  .mahando-specs__list--2 {
    @media screen and (min-width: 750px) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .mahando-specs__row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-block: 6px;
    border-bottom: 1px dashed var(--color-border);
    min-width: 0;
  }

  .mahando-specs__row:last-child {
    border-bottom: 0;
  }

  .mahando-specs__list--2 .mahando-specs__row:nth-last-child(2):nth-child(odd) {
    @media screen and (min-width: 750px) {
      border-bottom: 0;
    }
  }

  .mahando-specs__row dt {
    color: var(--color-foreground-muted);
  }

  .mahando-specs__row dd {
    margin: 0;
    font-weight: 600;
    text-align: end;
    font-variant-numeric: tabular-nums;
  }

  .mahando-specs {
    width: 100%;
  }

  .mahando-specs__zebra {
    width: 100%;
    display: flex;
    flex-direction: column;
    font-size: var(--font-size--sm);
  }

  .mahando-specs__group {
    margin: 16px 0 6px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .mahando-specs__group:first-child {
    margin-top: 0;
  }

  .mahando-specs__zrow {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 16px;
    padding: 10px 12px;
    border-radius: 6px;
  }

  .mahando-specs__zrow.is-odd {
    background: var(--color-background-secondary, #f4f8f9);
  }

  .mahando-specs__k {
    color: var(--color-foreground-muted);
  }

  .mahando-specs__v {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .mahando-specs__hint {
    margin: 0;
    padding: 10px 12px;
    border: 1px dashed var(--color-border);
    border-radius: 8px;
    font-size: var(--font-size--xs);
    color: var(--color-foreground-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Technische Daten",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Liest das Metafeld mahando.technische_daten (mehrzeiliger Text, eine Zeile je Eintrag: „Bezeichnung: Wert“)."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Darstellung",
      "options": [
        { "value": "list", "label": "Liste mit Rahmen" },
        { "value": "zebra", "label": "Tabelle gestreift (Gruppen mit #)" }
      ],
      "default": "list"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Spalten (Desktop)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "max_rows",
      "label": "Maximale Einträge",
      "min": 2,
      "max": 60,
      "step": 1,
      "default": 12
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Technische Daten",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
