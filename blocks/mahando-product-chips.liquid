{%- doc -%}
  Kleine Pills unter dem Produkttitel (Vorbild: sfhandel.com): Hersteller sowie Kategorie und
  Unterkategorie aus dem Hauptmenü, jeweils verlinkt.
{%- enddoc -%}

{%- liquid
  assign product = closest.product
  capture category_chips
    render 'mahando-product-category', product: product, format: 'chips'
  endcapture
  assign category_chips = category_chips | strip
-%}

{%- if product.vendor != blank or category_chips != blank -%}
  <div
    class="mahando-pchips spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.show_vendor and product.vendor != blank -%}
      <a class="mahando-pchip" href="{{ product.vendor | url_for_vendor }}">{{ 'mahando.product.vendor_label' | t }}: {{ product.vendor }}</a>
    {%- endif -%}
    {%- if block.settings.show_category -%}
      {{ category_chips }}
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .mahando-pchips {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .mahando-pchip {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-background);
    font-size: var(--font-size--2xs);
    font-weight: 600;
    color: var(--color-foreground);
    text-decoration: none;
    line-height: 1.3;
  }

  .mahando-pchip:hover {
    border-color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Produkt-Chips (Mahando)",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Hersteller",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "Kategorie und Unterkategorie",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Produkt-Chips (Mahando)",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
