{%- doc -%}
  Bewertungen von Marktplätzen (Vorbild: shop.cejuron.de).
  Daten: Shop-Metafeld mahando.marktplatz_bewertungen (JSON) mit
  { stand, plattformen: [{ name, konto, sterne, prozent, anzahl, zeitraum, url }],
    bewertungen: [{ quelle, sterne?, text, name, datum }] }.
  Kopf mit Überschrift und Plattform-Kästen, Karussell mit Pfeilen, Herkunftshinweis (§ 5b Abs. 3 UWG).
{%- enddoc -%}

{%- liquid
  assign data = shop.metafields.mahando.marktplatz_bewertungen.value
  assign platforms = data.plattformen
  assign reviews = data.bewertungen
  assign stand = data.stand | date: '%d.%m.%Y'
  assign uid = block.id | replace: '-', ''
-%}

{%- if platforms.size > 0 -%}
  <div class="mahando-mpr spacing-style" id="mpr-{{ uid }}" style="width: 100%; {% render 'spacing-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    <div class="mahando-mpr__head">
      <div class="mahando-mpr__intro">
        {%- if block.settings.heading != blank -%}
          <h2 class="mahando-mpr__heading">{{ block.settings.heading }}</h2>
        {%- endif -%}
        {%- if block.settings.subheading != blank -%}
          <p class="mahando-mpr__sub">{{ block.settings.subheading }}</p>
        {%- endif -%}
      </div>
      <div class="mahando-mpr__summary">
        {%- for p in platforms -%}
          <a class="mahando-mpr__platform" href="{{ p.url }}" target="_blank" rel="noopener nofollow">
            <span class="mahando-mpr__pname"><strong>{{ p.name | upcase }}</strong> als „{{ p.konto }}“</span>
            <span class="mahando-mpr__score">
              {%- if p.sterne != blank -%}
                {% render 'mahando-stars', rating: p.sterne, size: 16 %}
                <strong>{{ p.sterne | times: 1.0 | round: 1 | replace: '.', ',' }} von 5</strong>
              {%- else -%}
                <strong>{{ p.prozent | times: 1.0 | round: 1 | replace: '.', ',' }} % positiv</strong>
              {%- endif -%}
            </span>
            <span class="mahando-mpr__count">
              {{- p.anzahl }} Bewertungen {% if p.zeitraum == 'letzte 12 Monate' %}in 12 Monaten{% else %}({{ p.zeitraum }}){% endif %}
              {%- if p.sterne != blank and p.prozent != blank %} · {{ p.prozent | times: 1.0 | round: 1 | replace: '.', ',' }} % positiv{% endif -%}
            </span>
          </a>
        {%- endfor -%}
      </div>
    </div>

    {%- if reviews.size > 0 -%}
      <div class="mahando-mpr__slider">
        <button type="button" class="mahando-mpr__nav mahando-mpr__nav--prev" aria-label="Vorherige Bewertungen" data-dir="-1">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <ul class="mahando-mpr__list" role="list" aria-label="Bewertungen">
          {%- for r in reviews limit: block.settings.max_items -%}
            <li class="mahando-mpr__card">
              {%- if r.sterne != blank -%}
                {% render 'mahando-stars', rating: r.sterne, size: 16 %}
              {%- else -%}
                <span class="mahando-mpr__positive">+ Positiv</span>
              {%- endif -%}
              <p class="mahando-mpr__text">{{ r.text | escape }}</p>
              <p class="mahando-mpr__meta">
                <strong>{{ r.name | escape }}</strong><br>
                Käufer bei {{ r.quelle }},
                {% if r.datum contains '-' %}am {{ r.datum | date: '%d.%m.%Y' }}{% else %}{{ r.datum | replace: 'letzte', 'in den letzten' | replace: 'Monate', 'Monaten' }}{% endif %}
              </p>
            </li>
          {%- endfor -%}
        </ul>
        <button type="button" class="mahando-mpr__nav mahando-mpr__nav--next" aria-label="Weitere Bewertungen" data-dir="1">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    {%- endif -%}

    <p class="mahando-mpr__note">
      <strong>Woher diese Bewertungen stammen:</strong>
      Es sind Verkäuferbewertungen aus unseren Profilen bei eBay und Amazon; wir prüfen sie nicht selbst. Dort bewerten nur Käufer der jeweiligen Bestellung.
      Wir zeigen eine Auswahl positiver Bewertungen mit Text, Namen gekürzt. Die Sterne bei eBay sind der Durchschnitt der detaillierten Verkäuferbewertungen
      (Beschreibung, Versandkosten, Lieferzeit, Kommunikation) der letzten 12 Monate, bei Amazon die Verkäuferbewertung über die gesamte Laufzeit.
      Stand: {{ stand }}. Alle Bewertungen:
      {% for p in platforms %}<a href="{{ p.url }}" target="_blank" rel="noopener nofollow">{{ p.name }} „{{ p.konto }}“</a>{% unless forloop.last %}, {% endunless %}{% endfor %}
    </p>
  </div>

  <script>
    (() => {
      const root = document.getElementById('mpr-{{ uid }}');
      if (!root) return;
      const list = root.querySelector('.mahando-mpr__list');
      root.querySelectorAll('.mahando-mpr__nav').forEach((b) => {
        b.addEventListener('click', () => {
          const card = list.querySelector('.mahando-mpr__card');
          const step = card ? card.getBoundingClientRect().width + 16 : 300;
          list.scrollBy({ left: Number(b.dataset.dir) * step * 2, behavior: 'smooth' });
        });
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Marktplatz-Bewertungen",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Das sagen unsere Kunden" },
    { "type": "text", "id": "subheading", "label": "Unterzeile", "default": "Bewertungen von Käufern, die bei Mahando über eBay und Amazon bestellt haben" },
    { "type": "range", "id": "max_items", "label": "Maximal angezeigte Bewertungen", "min": 3, "max": 20, "step": 1, "default": 12 },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-inline-start", "label": "t:settings.left", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-inline-end", "label": "t:settings.right", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Marktplatz-Bewertungen" }]
}
{% endschema %}
