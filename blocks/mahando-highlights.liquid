{%- doc -%}
  „Auf einen Blick“ – bis zu fünf Stichpunkte unter dem Produkttitel (Vorbild: sfhandel.com).
  Quelle 1: Metafeld mahando.highlights (mehrzeiliger Text, eine Zeile je Punkt, oder Listen-Metafeld).
  Quelle 2 (Fallback): die ersten Listenpunkte (<li>) aus der Produktbeschreibung.
  Ohne Inhalt bleibt der Block im Shop unsichtbar.
{%- enddoc -%}

{%- liquid
  assign product = closest.product
  assign max_items = block.settings.max_items | default: 4
  assign items = ''
  assign field = product.metafields.mahando.highlights

  if field.type == 'list.single_line_text_field'
    for entry in field.value
      assign clean = entry | strip
      if clean != blank
        assign items = items | append: clean | append: '||'
      endif
    endfor
  elsif field.value != blank
    assign lines = field.value | newline_to_br | split: '<br />'
    for line in lines
      assign clean = line | strip_html | strip
      assign first = clean | slice: 0, 2
      if first == '- ' or first == '• ' or first == '* '
        assign clean = clean | remove_first: first | strip
      endif
      if clean != blank
        assign items = items | append: clean | append: '||'
      endif
    endfor
  endif

  if items == blank and block.settings.fallback_description and product.description contains '<li'
    assign parts = product.description | split: '<li'
    for part in parts offset: 1
      assign segment = part | split: '</li>' | first
      assign attr = segment | split: '>' | first
      assign clean = segment | remove_first: attr | remove_first: '>' | strip_html | strip
      if clean != blank
        assign items = items | append: clean | append: '||'
      endif
      if forloop.index >= max_items
        break
      endif
    endfor
  endif

  assign items = items | split: '||'
-%}

{%- if items.size > 0 -%}
  <div
    class="mahando-highlights spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.heading != blank -%}
      <p class="mahando-highlights__title">{{ block.settings.heading }}</p>
    {%- endif -%}
    <ul class="mahando-highlights__list" role="list">
      {%- for item in items limit: max_items -%}
        <li>
          {% render 'mahando-icon', icon: 'check', class: 'mahando-highlights__icon' %}
          <span>{{ item }}</span>
        </li>
      {%- endfor -%}
    </ul>
    {%- if block.settings.more_anchor != blank and block.settings.more_text != blank -%}
      <a class="mahando-highlights__more" href="#{{ block.settings.more_anchor | strip | remove: '#' }}">{{ block.settings.more_text }}</a>
    {%- endif -%}
  </div>
{%- elsif request.design_mode -%}
  <p class="mahando-highlights__hint" {{ block.shopify_attributes }}>„Auf einen Blick“: weder Metafeld „mahando.highlights“ noch eine Liste in der Beschreibung vorhanden – der Block bleibt im Shop unsichtbar.</p>
{%- endif -%}

{% stylesheet %}
  .mahando-highlights {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 14px 16px;
    background: var(--color-background);
    font-size: var(--font-size--sm);
    line-height: 1.45;
  }

  .mahando-highlights__title {
    margin: 0 0 8px;
    font-weight: 700;
    font-size: var(--font-size--sm);
  }

  .mahando-highlights__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  .mahando-highlights__list li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .mahando-highlights__icon {
    flex: none;
    width: 16px;
    height: 16px;
    margin-top: 2px;
    color: var(--color-primary-button-background);
  }

  .mahando-highlights__more {
    display: inline-block;
    margin-top: 10px;
    font-weight: 600;
    color: var(--color-primary-button-background);
    text-decoration: none;
  }

  .mahando-highlights__more:hover {
    text-decoration: underline;
  }

  .mahando-highlights__hint {
    margin: 0;
    padding: 10px 12px;
    border: 1px dashed var(--color-border);
    border-radius: 8px;
    font-size: var(--font-size--xs);
    color: var(--color-foreground-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Auf einen Blick (Mahando)",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Auf einen Blick"
    },
    {
      "type": "range",
      "id": "max_items",
      "label": "Maximale Anzahl Punkte",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "fallback_description",
      "label": "Listenpunkte aus der Beschreibung verwenden, wenn das Metafeld leer ist",
      "default": true
    },
    {
      "type": "text",
      "id": "more_text",
      "label": "Link-Text",
      "default": "Mehr Details anzeigen"
    },
    {
      "type": "text",
      "id": "more_anchor",
      "label": "Sprungziel (Anker-ID)",
      "info": "z. B. beschreibung – passend zum Block „Abschnittstitel (Mahando)“",
      "default": "beschreibung"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Auf einen Blick (Mahando)",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
