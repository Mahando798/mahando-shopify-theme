{%- doc -%}
  Vertrauenshinweise unter dem Warenkorb-Button (Vorbild: sfhandel.com):
  bis zu vier Zeilen mit Icon und Text, optional verlinkt (z. B. Widerrufsrecht → Widerrufsbelehrung).
{%- enddoc -%}

{%- liquid
  assign rows = ''
  for i in (1..4)
    assign text_key = 'text_' | append: i
    assign icon_key = 'icon_' | append: i
    assign url_key = 'url_' | append: i
    assign text = block.settings[text_key]
    if text != blank
      assign icon = block.settings[icon_key] | default: 'check'
      assign url = block.settings[url_key]
      assign rows = rows | append: icon | append: '~' | append: text | append: '~' | append: url | append: '||'
    endif
  endfor
  assign rows = rows | split: '||'
-%}

{%- if rows.size > 0 -%}
  <ul
    class="mahando-trust spacing-style"
    role="list"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    {%- for row in rows -%}
      {%- assign parts = row | split: '~' -%}
      <li>
        {% render 'mahando-icon', icon: parts[0], class: 'mahando-trust__icon' %}
        {%- if parts[2] != blank -%}
          <a href="{{ parts[2] }}">{{ parts[1] }}</a>
        {%- else -%}
          <span>{{ parts[1] }}</span>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
{%- endif -%}

{% stylesheet %}
  .mahando-trust {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    font-size: var(--font-size--xs);
    font-weight: 600;
  }

  .mahando-trust li {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 0;
    border-top: 1px solid var(--color-border);
  }

  .mahando-trust li:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .mahando-trust__icon {
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--color-primary-button-background);
  }

  .mahando-trust a {
    color: inherit;
    text-decoration: none;
  }

  .mahando-trust a:hover {
    text-decoration: underline;
  }
{% endstylesheet %}

