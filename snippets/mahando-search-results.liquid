{%- doc -%}
  Kompakte Suchvorschläge (Mahando) aus dem predictive_search-Objekt: Suchbegriffe, Produkte als Zeilen
  mit Bild, Kategorien und Seiten als Chips, dazu der Link zur vollständigen Ergebnisseite.
  Wird vom Dropdown der Header-Suchleiste (Section mahando-search-suggest) und vom Such-Dialog
  (Section predictive-search, mobil) verwendet.

  @param {string} [context] - 'dropdown' (Header-Suchleiste) oder 'modal' (Such-Dialog)
  @param {number} [product_limit] - Anzahl der Produktzeilen (Standard 6)
{%- enddoc -%}

{%- liquid
  assign context = context | default: 'dropdown'
  assign product_limit = product_limit | default: 6
  assign terms = predictive_search.terms
  assign products = predictive_search.resources.products
  assign found_collections = predictive_search.resources.collections
  assign found_pages = predictive_search.resources.pages
  assign queries = predictive_search.resources.queries
  assign result_count = products.size | plus: found_collections.size | plus: found_pages.size | plus: predictive_search.resources.articles.size
  assign terms_encoded = terms | url_encode
  assign all_url = routes.search_url | append: '?q=' | append: terms_encoded | append: '&options%5Bprefix%5D=last'
-%}

<div class="mahando-search-results mahando-search-results--{{ context }}" data-terms="{{ terms | escape }}">
  <div class="visually-hidden" role="status">
    {%- if result_count > 0 -%}
      {{ 'accessibility.search_results_count' | t: count: result_count, query: terms }}
    {%- elsif queries.size > 0 -%}
      {{ 'accessibility.search_suggestions_available' | t: query: terms }}
    {%- else -%}
      {{ 'accessibility.search_results_no_results' | t: query: terms }}
    {%- endif -%}
  </div>

  {%- if queries.size > 0 -%}
    <ul
      class="predictive-search-results__list mahando-search-list mahando-search-list--queries list-unstyled"
      role="group"
      aria-label="{{ 'mahando.search.suggestions' | t }}"
    >
      {%- for query in queries limit: 4 -%}
        <li
          class="mahando-search-row mahando-search-row--query"
          ref="resultsItems[]"
          role="option"
          aria-label="{{ query.text | escape }}"
        >
          <a class="mahando-search-row__link" href="{{ query.url }}" data-search-item tabindex="-1">
            <span class="mahando-search-row__icon svg-wrapper" aria-hidden="true">{{ 'icon-search.svg' | inline_asset_content }}</span>
            <span class="mahando-search-row__query">{{ query.styled_text }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- if products.size > 0 -%}
    <p class="mahando-search-heading">{{ 'content.search_results_resource_products' | t }}</p>
    <ul
      class="predictive-search-results__list mahando-search-list mahando-search-list--products list-unstyled"
      role="group"
      aria-label="{{ 'content.search_results_resource_products' | t }}"
    >
      {%- for product in products limit: product_limit -%}
        {%- render 'mahando-search-row', product: product -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- if found_collections.size > 0 or found_pages.size > 0 -%}
    <div class="mahando-search-chips-wrap">
      {%- if found_collections.size > 0 -%}
        <p class="mahando-search-heading">{{ 'mahando.search.collections' | t }}</p>
        <ul class="predictive-search-results__list mahando-search-chips list-unstyled" role="group" aria-label="{{ 'mahando.search.collections' | t }}">
          {%- for collection in found_collections limit: 4 -%}
            <li class="mahando-search-chip" ref="resultsItems[]" role="option" aria-label="{{ collection.title | escape }}">
              <a href="{{ collection.url }}" data-search-item tabindex="-1">{{ collection.title | escape }}</a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if found_pages.size > 0 -%}
        <p class="mahando-search-heading">{{ 'mahando.search.pages' | t }}</p>
        <ul class="predictive-search-results__list mahando-search-chips list-unstyled" role="group" aria-label="{{ 'mahando.search.pages' | t }}">
          {%- for page in found_pages limit: 3 -%}
            <li class="mahando-search-chip" ref="resultsItems[]" role="option" aria-label="{{ page.title | escape }}">
              <a href="{{ page.url }}" data-search-item tabindex="-1">{{ page.title | escape }}</a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if result_count == 0 and queries.size == 0 -%}
    <p class="mahando-search-empty predictive-search-results__no-results">
      {{ 'mahando.search.no_results' | t: terms: terms }}
      <span>{{ 'mahando.search.no_results_hint' | t }}</span>
    </p>
  {%- endif -%}

  <a class="mahando-search-all" href="{{ all_url }}" data-search-item tabindex="-1">
    <span>
      {%- if result_count > 0 -%}
        {{ 'mahando.search.view_all' | t: terms: terms }}
      {%- else -%}
        {{ 'mahando.search.search_page' | t: terms: terms }}
      {%- endif -%}
    </span>
    <span class="svg-wrapper" aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
  </a>
</div>

{% stylesheet %}
  .mahando-search-results {
    display: grid;
    gap: 2px;
    font-size: var(--font-size--sm);
    color: var(--color-foreground);
    text-align: start;
  }

  .mahando-search-results--modal {
    padding-inline: var(--padding-sm);
  }

  .mahando-search-heading {
    margin: 10px 14px 2px;
    font-size: var(--font-size--xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .mahando-search-results > :first-child + .mahando-search-heading,
  .mahando-search-results > .mahando-search-list--queries + .mahando-search-heading {
    margin-top: 6px;
  }

  .mahando-search-list {
    list-style: none;
    margin: 0;
    padding: 0 6px;
    display: grid;
    gap: 1px;
  }

  .mahando-search-list--queries {
    padding-top: 4px;
  }

  .mahando-search-row__link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 7px 8px;
    border-radius: 8px;
    color: inherit;
    text-decoration: none;
  }

  .mahando-search-row__link:hover,
  .mahando-search-row[aria-selected='true'] .mahando-search-row__link {
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .mahando-search-row--query .mahando-search-row__link {
    padding-block: 6px;
    gap: 10px;
  }

  .mahando-search-row__icon {
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--color-foreground-muted);
  }

  .mahando-search-row__icon svg {
    width: 16px;
    height: 16px;
  }

  .mahando-search-row__query {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mahando-search-row__query :is(b, strong) {
    font-weight: 700;
  }

  .mahando-search-row__media {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    padding: 3px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: #fff;
    overflow: hidden;
  }

  .mahando-search-row__media img,
  .mahando-search-row__media svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .mahando-search-row__body {
    display: grid;
    gap: 3px;
    min-width: 0;
  }

  .mahando-search-row__title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.3;
    font-weight: 500;
  }

  .mahando-search-row__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 10px;
    font-size: var(--font-size--xs);
    color: var(--color-foreground-muted);
  }

  .mahando-search-row__price {
    font-weight: 700;
    color: var(--color-foreground);
  }

  .mahando-search-row__price s {
    margin-inline-start: 6px;
    font-weight: 400;
    color: var(--color-foreground-muted);
  }

  .mahando-search-row__stock {
    color: #157a45;
    font-weight: 600;
  }

  .mahando-search-row__stock--out {
    color: var(--color-foreground-muted);
    font-weight: 400;
  }

  .mahando-search-chips-wrap {
    display: grid;
    gap: 2px;
  }

  .mahando-search-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 2px 14px 6px;
    list-style: none;
  }

  .mahando-search-chip a {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 4px 12px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: var(--font-size--xs);
    font-weight: 500;
    color: inherit;
    text-decoration: none;
  }

  .mahando-search-chip a:hover,
  .mahando-search-chip[aria-selected='true'] a {
    border-color: var(--color-foreground);
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .mahando-search-empty {
    margin: 12px 14px 6px;
    font-weight: 500;
  }

  .mahando-search-empty span {
    display: block;
    margin-top: 3px;
    font-size: var(--font-size--xs);
    font-weight: 400;
    color: var(--color-foreground-muted);
  }

  .mahando-search-all {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 6px 6px 0;
    padding: 11px 8px;
    border-top: 1px solid var(--color-border);
    border-radius: 0 0 8px 8px;
    font-weight: 600;
    color: var(--color-primary-button-background);
    text-decoration: none;
  }

  .mahando-search-all:hover,
  .mahando-search-all[aria-selected='true'] {
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .mahando-search-all .svg-wrapper,
  .mahando-search-all svg {
    flex: none;
    width: 18px;
    height: 18px;
  }
{% endstylesheet %}
