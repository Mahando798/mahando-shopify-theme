{%- doc -%}
  Renders the search action button.

  @param {string} [style] - The style of the search action.
  @param {string} [class] - Additional classes for the search action.
  @param {string} [display_style] - The display style ('icon' or 'text').
  @param {string} [variant] - 'bar' renders the large Mahando search bar with inline suggestions (desktop), anything else the icon button.

  @example
  {% render 'search', style: 'default', class: 'custom-class', display_style: 'icon' %}
{%- enddoc -%}

{% if style != 'none' and variant == 'bar' %}
  {%- liquid
    assign bar_placeholder = 'content.search' | t
    if settings.mahando_search_placeholder != blank
      assign bar_placeholder = settings.mahando_search_placeholder
    endif
  -%}
  <script src="{{ 'mahando-search.js' | asset_url }}" type="module" fetchpriority="low"></script>
  <mahando-search
    class="search-action search-action--bar{% if class != blank %} {{ class | strip }}{% endif %}"
    data-url="{{ routes.predictive_search_url }}"
    data-section="mahando-search-suggest"
  >
    <form
      action="{{ routes.search_url }}"
      method="get"
      role="search"
      class="mahando-search-bar"
      autocomplete="off"
    >
      <input type="hidden" name="options[prefix]" value="last">
      <label for="mahando-search-input" class="visually-hidden">{{ 'content.search_input_label' | t }}</label>
      <input
        id="mahando-search-input"
        class="mahando-search-bar__input"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ bar_placeholder | escape }}"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="false"
        aria-controls="mahando-search-panel"
        aria-autocomplete="list"
        aria-haspopup="listbox"
        enterkeyhint="search"
      >
      <button
        type="button"
        class="button-unstyled mahando-search-bar__clear"
        aria-label="{{ 'mahando.search.clear' | t }}"
        hidden
      >
        <span class="svg-wrapper">{{ 'icon-close.svg' | inline_asset_content }}</span>
      </button>
      <button type="submit" class="button-unstyled mahando-search-bar__submit">
        <span class="svg-wrapper">{{ 'icon-search.svg' | inline_asset_content }}</span>
        <span class="mahando-search-bar__label">{{ 'content.search' | t }}</span>
      </button>
    </form>
    <div
      id="mahando-search-panel"
      class="mahando-search-panel"
      role="listbox"
      aria-label="{{ 'mahando.search.suggestions' | t }}"
      hidden
    ></div>
  </mahando-search>
{% endif %}

{% unless style == 'none' %}
  <search-button
    class="search-action{% if display_style == 'text' %} search-action--text{% endif %}{% if variant == 'bar' %} search-action--bar-fallback{% endif %}{% if class != blank %} {{ class | strip }}{% endif %}"
  >
    <button
      on:click="#search-modal/showDialog"
      class="button-unstyled header-actions__action{% if display_style == 'text' %} header-actions__text-style{% endif %}"
      aria-label="{{ 'content.search_input_label' | t }}"
      aria-haspopup="dialog"
    >
      <span class="{% if display_style == 'icon' %}hidden{% else %}mobile:hidden{% endif %}">
        {{ 'content.search' | t }}
      </span>

      <span class="svg-wrapper {% if display_style != 'icon' %}desktop:hidden{% endif %}">
        {{ 'icon-search.svg' | inline_asset_content }}
      </span>
    </button>
  </search-button>
{% endunless %}

{% stylesheet %}
  mahando-search.search-action--bar {
    flex: 1 1 auto;
    min-width: 0;
    max-width: 640px;
    width: 100%;
    position: relative;
    display: block;
  }

  .mahando-search-bar {
    display: flex;
    align-items: stretch;
    width: 100%;
    min-height: 44px;
    margin: 0;
    border: 1.5px solid var(--color-input-border, var(--color-border));
    border-radius: var(--style-border-radius-inputs, 8px);
    background: var(--color-input-background, var(--color-background));
    color: var(--color-input-text, var(--color-foreground));
    overflow: hidden;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .mahando-search-bar:focus-within {
    border-color: var(--color-primary-button-background);
    box-shadow: 0 0 0 3px rgb(var(--color-foreground-rgb) / 0.08);
  }

  .mahando-search-bar__input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0 14px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    font-size: var(--font-size--sm);
    line-height: 1.2;
    outline: none;
    box-shadow: none;
    appearance: none;
  }

  .mahando-search-bar__input::placeholder {
    color: rgb(var(--color-input-text-rgb, var(--color-foreground-rgb)) / 0.55);
  }

  .mahando-search-bar__input::-webkit-search-decoration,
  .mahando-search-bar__input::-webkit-search-cancel-button,
  .mahando-search-bar__input::-webkit-search-results-button {
    appearance: none;
    display: none;
  }

  .mahando-search-bar__input:is(:focus, :focus-visible, :hover) {
    outline: none;
    box-shadow: none;
    background: transparent;
  }

  .mahando-search-bar__clear {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    color: rgb(var(--color-input-text-rgb, var(--color-foreground-rgb)) / 0.6);
    cursor: pointer;
  }

  .mahando-search-bar__clear:hover {
    color: var(--color-foreground);
  }

  .mahando-search-bar__clear[hidden] {
    display: none;
  }

  .mahando-search-bar__clear .svg-wrapper,
  .mahando-search-bar__clear svg {
    width: 14px;
    height: 14px;
  }

  .mahando-search-bar__submit {
    flex: none;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 16px;
    background: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    font-weight: 600;
    font-size: var(--font-size--sm);
    cursor: pointer;
  }

  .mahando-search-bar__submit:hover {
    background: var(--color-primary-button-hover-background, var(--color-primary-button-background));
  }

  .mahando-search-bar__submit .svg-wrapper,
  .mahando-search-bar__submit svg {
    width: 18px;
    height: 18px;
  }

  .mahando-search-panel {
    position: absolute;
    top: calc(100% + 6px);
    inset-inline-end: 0;
    width: max(100%, 560px);
    max-width: calc(100vw - 32px);
    max-height: min(72vh, 760px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 6px 0 6px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-background, #fff);
    color: var(--color-foreground);
    box-shadow: 0 14px 36px rgb(0 0 0 / 0.16);
    z-index: var(--layer-overlay);
    text-align: start;
  }

  .mahando-search-panel[hidden] {
    display: none;
  }

  mahando-search.is-loading .mahando-search-bar__submit .svg-wrapper {
    animation: mahando-search-pulse 0.9s ease-in-out infinite;
  }

  @keyframes mahando-search-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.45;
    }
  }

  @media screen and (max-width: 989px) {
    mahando-search.search-action--bar {
      display: none;
    }
  }

  #header-component[data-menu-style='drawer'] mahando-search.search-action--bar {
    display: none;
  }

  @media screen and (min-width: 990px) {
    #header-component[data-menu-style='menu'] .search-action--bar-fallback {
      display: none;
    }
  }

  .search-action {
    --search-border-radius: var(--style-border-radius-inputs);
    --search-border-width: var(--style-border-width-inputs);

    display: flex;
  }

  @media screen and (max-width: 749px) {
    .search-action--hidden-on-drawer {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    [data-menu-style='drawer'] .search-action--hidden-on-drawer {
      display: none;
    }

    [data-menu-style='menu'] .search-action--hidden-on-menu {
      display: none;
    }
  }

  [data-menu-style='menu'] .header__column--left .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--padding-lg) * -1);
    }
  }

  .header__column--right .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--gap-md) * -1) calc(var(--gap-xs) * -1);
    }
  }

  @media screen and (min-width: 750px) {
    .header__column--right .search-action--text {
      margin-inline: 0;
    }

    [data-menu-style='menu'] .header__column--left .search-action--text {
      margin-inline: 0;
    }
  }
{% endstylesheet %}
