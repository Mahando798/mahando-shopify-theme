{%- doc -%}
  USP-Leiste über dem Header: bis zu vier Vorteile mit Icon links, Servicezeiten + Telefon rechts.
  Auf Mobilgeräten wird nur der erste Vorteil angezeigt.
{%- enddoc -%}

{% render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="mahando-usp section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  aria-label="Vorteile und Kontakt"
>
  <div class="mahando-usp__inner">
    <ul class="mahando-usp__list">
      {%- for block in section.blocks -%}
        {%- if block.settings.text == blank -%}{%- continue -%}{%- endif -%}
        <li class="mahando-usp__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            {% render 'mahando-icon', icon: block.settings.icon, class: 'mahando-usp__icon' %}
          {%- endif -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            <span>{{ block.settings.text }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.show_contact -%}
      <div class="mahando-usp__contact">
        {%- if settings.mahando_hours != blank -%}
          <span class="mahando-usp__hours">{{ settings.mahando_hours }}</span>
        {%- endif -%}
        {%- if settings.mahando_phone != blank -%}
          {%- assign tel = settings.mahando_phone | remove: ' ' | remove: '-' | remove: '/' -%}
          <a class="mahando-usp__phone" href="tel:{{ tel }}"><span class="visually-hidden">{{ 'mahando.usp.phone_label' | t }}: </span>{{ settings.mahando_phone }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</aside>

{% stylesheet %}
  .mahando-usp {
    font-size: var(--font-size--xs);
    min-height: 34px;
  }

  .mahando-usp__inner {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: 34px;
    overflow: hidden;
  }

  .mahando-usp__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 22px;
    min-width: 0;
  }

  .mahando-usp__item {
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  .mahando-usp__item a {
    color: inherit;
    text-decoration: none;
  }

  .mahando-usp__item a:hover {
    text-decoration: underline;
  }

  .mahando-usp__icon {
    width: 14px;
    height: 14px;
    flex: none;
    opacity: 0.7;
  }

  .mahando-usp__contact {
    margin-inline-start: auto;
    display: flex;
    gap: 14px;
    align-items: center;
    white-space: nowrap;
  }

  .mahando-usp__phone {
    color: inherit;
    font-weight: 700;
    text-decoration: none;
  }

  @media screen and (max-width: 749px) {
    .mahando-usp__item:not(:first-child),
    .mahando-usp__hours {
      display: none;
    }
  }

  @media screen and (max-width: 989px) {
    .mahando-usp__item:nth-child(n + 3) {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "USP-Leiste (Mahando)",
  "tag": "div",
  "class": "section-wrapper",
  "enabled_on": {
    "groups": ["header"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "Servicezeiten und Telefon rechts anzeigen",
      "info": "Werte aus den Theme-Einstellungen → Mahando → Kontakt",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text",
      "default": "#DCE5E9"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "Vorteil",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "Kein Icon" },
            { "value": "truck", "label": "Lieferwagen" },
            { "value": "shield", "label": "Schild (Sicherheit)" },
            { "value": "box", "label": "Paket" },
            { "value": "undo", "label": "Rückgabe" },
            { "value": "headset", "label": "Service" },
            { "value": "check", "label": "Haken" },
            { "value": "clock", "label": "Uhr" },
            { "value": "tag", "label": "Preisschild" },
            { "value": "star", "label": "Stern" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Versand aus Deutschland"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "USP-Leiste (Mahando)",
      "blocks": [
        { "type": "usp", "settings": { "icon": "truck", "text": "Versand aus Deutschland – Lager Büren" } },
        { "type": "usp", "settings": { "icon": "shield", "text": "Sichere Zahlung: PayPal, Klarna, Karte, Rechnung" } },
        { "type": "usp", "settings": { "icon": "box", "text": "Versand 4,99 € pauschal · ab 300 € kostenlos" } }
      ]
    }
  ]
}
{% endschema %}
