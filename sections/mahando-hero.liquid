{%- comment -%}
  Startseiten-Hero: links Eyebrow, Überschrift, Text und zwei Buttons; rechts bis zu drei Produktkarten
  (Bild, Titel, Untertitel, Preis) als "Angebote der Woche". Ruhige, helle Fläche mit Rahmen.
{%- endcomment -%}

{%- liquid
  assign hero_style = section.settings.style | default: 'light'
  case hero_style
    when 'dark'
      assign hero_bg = '#1d2b33'
    when 'teal'
      assign hero_bg = '#0a7e83'
    when 'image'
      assign hero_bg = '#1d2b33'
    else
      assign hero_bg = section.settings.background_color
  endcase
  if hero_style == 'image' and section.settings.background_image == blank
    assign hero_style = 'dark'
  endif
-%}

{% render 'contrast-override', background_color: hero_bg, section_id: section.id %}

<div
  class="mahando-hero-section section section--page-width spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- liquid
    assign visible_cards = 0
    for block in section.blocks
      if block.settings.product != blank or request.design_mode
        assign visible_cards = visible_cards | plus: 1
      endif
    endfor
  -%}
  <div class="mahando-hero mahando-hero--{{ hero_style }} color-custom-{{ section.id }}{% if visible_cards == 0 %} mahando-hero--single{% endif %}">
    {%- if hero_style == 'image' -%}
      {{
        section.settings.background_image
        | image_url: width: 2000
        | image_tag: loading: 'eager', class: 'mahando-hero__bg', alt: '', widths: '900, 1400, 2000', sizes: '(min-width: 1400px) 1320px, 100vw'
      }}
      <span class="mahando-hero__overlay" style="opacity: {{ section.settings.overlay_opacity | default: 70 | divided_by: 100.0 }};"></span>
    {%- endif -%}
    {%- if section.settings.show_waves and hero_style != 'light' -%}
      <img class="mahando-hero__waves" src="{{ 'mahando-logo-mark.svg' | asset_url }}" alt="" aria-hidden="true" loading="lazy" width="231" height="101">
    {%- endif -%}
    <div class="mahando-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="mahando-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="mahando-hero__heading h1">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="mahando-hero__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
        <div class="mahando-hero__buttons">
          {%- if section.settings.button_label != blank -%}
            <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a class="button button-secondary" href="{{ section.settings.button_link_2 | default: routes.collections_url }}">{{ section.settings.button_label_2 }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if visible_cards > 0 -%}
      <div class="mahando-hero__stack" aria-label="{{ section.settings.stack_label | escape }}">
        {%- for block in section.blocks -%}
          {%- if block.settings.product == blank and request.design_mode == false -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign product = block.settings.product
            assign title = block.settings.title
            if title == blank
              assign title = product.title
            endif
            assign img_alt = product.featured_image.alt | default: title
          -%}
          <a
            class="mahando-hero__card"
            href="{{ product.url | default: '#' }}"
            {{ block.shopify_attributes }}
          >
            <span class="mahando-hero__card-image">
              {%- if product.featured_image != blank -%}
                {{ product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '72px', alt: img_alt }}
              {%- else -%}
                {{ 'product-apparel-1' | placeholder_svg_tag: 'mahando-hero__placeholder' }}
              {%- endif -%}
            </span>
            <span class="mahando-hero__card-text">
              <strong>{{ title | default: 'Produkt auswählen' }}</strong>
              {%- if block.settings.subtitle != blank -%}
                <small>{{ block.settings.subtitle }}</small>
              {%- elsif product.type != blank -%}
                <small>{{ product.type }}</small>
              {%- endif -%}
            </span>
            <span class="mahando-hero__card-price">
              {%- if product != blank -%}
                {% render 'price', product_resource: product, show_sale_price_first: true %}
              {%- endif -%}
            </span>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .mahando-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 32px;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: 18px;
    padding: 46px 48px;
    background: var(--color-background);
  }

  .mahando-hero--single {
    grid-template-columns: 1fr;
  }

  /* Dunkle, türkise und Bild-Varianten */
  .mahando-hero--dark,
  .mahando-hero--teal,
  .mahando-hero--image {
    position: relative;
    overflow: hidden;
    border-color: transparent;
    isolation: isolate;
  }

  .mahando-hero--teal {
    background: linear-gradient(135deg, #0a7e83 0%, #0b5f66 100%);
  }

  .mahando-hero--image {
    background: #1d2b33;
  }

  .mahando-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .mahando-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #10181e 0%, #10181e 45%, rgb(16 24 30 / 0.55) 100%);
    z-index: -1;
  }

  .mahando-hero__waves {
    position: absolute;
    right: -3%;
    bottom: -14%;
    width: min(58%, 680px);
    height: auto;
    opacity: 0.28;
    pointer-events: none;
    z-index: -1;
  }

  .mahando-hero--single .mahando-hero__waves {
    width: min(48%, 640px);
  }

  .mahando-hero--dark .mahando-hero__text,
  .mahando-hero--teal .mahando-hero__text,
  .mahando-hero--image .mahando-hero__text,
  .mahando-hero--dark .mahando-eyebrow,
  .mahando-hero--teal .mahando-eyebrow,
  .mahando-hero--image .mahando-eyebrow {
    color: rgb(255 255 255 / 0.82);
  }

  .mahando-hero--teal .button:not(.button-secondary) {
    background: #fff;
    color: #0a7e83;
    border-color: #fff;
  }

  .mahando-hero--dark .button-secondary,
  .mahando-hero--teal .button-secondary,
  .mahando-hero--image .button-secondary {
    background: transparent;
    border-color: rgb(255 255 255 / 0.6);
    color: #fff;
  }

  .mahando-hero--dark .button-secondary:hover,
  .mahando-hero--teal .button-secondary:hover,
  .mahando-hero--image .button-secondary:hover {
    background: rgb(255 255 255 / 0.12);
    border-color: #fff;
    color: #fff;
  }

  .mahando-hero--dark .mahando-hero__card,
  .mahando-hero--teal .mahando-hero__card,
  .mahando-hero--image .mahando-hero__card {
    background: #fff;
    color: #1d2b33;
    border-color: rgb(255 255 255 / 0.35);
  }

  .mahando-hero--dark .mahando-hero__card-text small,
  .mahando-hero--teal .mahando-hero__card-text small,
  .mahando-hero--image .mahando-hero__card-text small,
  .mahando-hero--dark .mahando-hero__card-price .compare-at-price,
  .mahando-hero--teal .mahando-hero__card-price .compare-at-price,
  .mahando-hero--image .mahando-hero__card-price .compare-at-price {
    color: #6b7a83;
  }

  .mahando-hero--dark .mahando-hero__card-image,
  .mahando-hero--teal .mahando-hero__card-image,
  .mahando-hero--image .mahando-hero__card-image {
    background: #f5f8f9;
  }

  .mahando-hero__heading {
    margin: 0;
    max-width: 20ch;
    text-wrap: balance;
  }

  .mahando-hero__text {
    margin-top: 14px;
    max-width: 46ch;
    font-size: var(--font-size--md);
    color: var(--color-foreground-subdued);
  }

  .mahando-hero__text p {
    margin: 0;
  }

  .mahando-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  .mahando-hero__stack {
    display: grid;
    gap: 12px;
    justify-self: end;
    width: min(100%, 400px);
  }

  .mahando-hero__card {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) auto;
    gap: 14px;
    align-items: center;
    padding: 12px;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    color: inherit;
    text-decoration: none;
    transition: box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .mahando-hero__card:hover {
    border-color: var(--color-foreground-muted);
    box-shadow: 0 10px 28px -14px rgb(var(--color-foreground-rgb) / 0.22);
  }

  .mahando-hero__card:nth-child(2) {
    transform: translateX(-24px);
  }

  .mahando-hero__card:nth-child(3) {
    transform: translateX(-48px);
  }

  .mahando-hero__card-image {
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / 0.05);
    display: grid;
    place-items: center;
  }

  .mahando-hero__card-image img,
  .mahando-hero__placeholder {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .mahando-hero__card-text {
    display: grid;
    gap: 2px;
    min-width: 0;
    font-size: var(--font-size--sm);
    line-height: 1.25;
  }

  .mahando-hero__card-text small {
    color: var(--color-foreground-muted);
    font-size: var(--font-size--xs);
  }

  .mahando-hero__card-price {
    font-weight: 700;
    font-size: var(--font-size--md);
    white-space: nowrap;
    text-align: end;
  }

  .mahando-hero__card-price .compare-at-price {
    display: block;
    font-size: var(--font-size--xs);
    font-weight: 400;
    color: var(--color-foreground-muted);
  }

  @media screen and (max-width: 989px) {
    .mahando-hero {
      grid-template-columns: 1fr;
      padding: 28px 22px;
      gap: 24px;
    }

    .mahando-hero__stack {
      width: 100%;
      justify-self: stretch;
    }

    .mahando-hero__card:nth-child(n) {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero (Mahando)",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleine Zeile über der Überschrift",
      "default": "Markenware · Ab Lager"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Ihr Onlinehändler für Technik, Haushalt und Spielzeug"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Mehr als 200.000 Verkäufe über Amazon, eBay und Kaufland. Ab sofort auch direkt: gleiches Sortiment, gleiche Leistungen, ohne Marktplatzgebühren.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button 1 – Text",
      "default": "Bestseller ansehen"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button 1 – Link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Button 2 – Text",
      "default": "Alle Kategorien"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Button 2 – Link"
    },
    {
      "type": "text",
      "id": "stack_label",
      "label": "Bezeichnung der Produktkarten (Screenreader)",
      "default": "Angebote der Woche"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Darstellung",
      "options": [
        { "value": "light", "label": "Hell (weiße Karte)" },
        { "value": "dark", "label": "Dunkel" },
        { "value": "teal", "label": "Türkis" },
        { "value": "image", "label": "Foto mit dunkler Überlagerung" }
      ],
      "default": "light"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Hintergrundfoto (bei „Foto“)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Abdunklung des Fotos",
      "min": 30,
      "max": 95,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "checkbox",
      "id": "show_waves",
      "label": "Logo-Wellen als Grafik einblenden",
      "info": "Nur bei Dunkel, Türkis und Foto",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Produktkarte",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produkt"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel (optional, sonst Produkttitel)"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Untertitel (optional, sonst Produkttyp)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero (Mahando)",
      "category": "t:categories.banners",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
