{%- comment -%}
  Seite „Kundenbewertungen“: Gesamtbewertung, Verteilung und alle Bewertungen (Shop- und Produktbewertungen)
  aus Judge.me. Daten kommen serverseitig aus shop.metafields.judgeme.reviews_grid (von Judge.me gepflegt),
  daher ohne Nachladen per JavaScript.
{%- endcomment -%}

{%- liquid
  assign grid = shop.metafields.judgeme.reviews_grid.value
  assign reviews = grid.all_reviews.reviews
  assign count = shop.metafields.judgeme.all_reviews_count.value | plus: 0
  assign rating = shop.metafields.judgeme.all_reviews_rating.value | times: 1.0
  if count == 0 and reviews.size > 0
    assign count = reviews.size
  endif
-%}

<div class="section section--{{ section.settings.section_width }} spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="mahando-rp">
    <header class="mahando-rp__head">
      <div class="mahando-rp__intro">
        {%- if section.settings.heading != blank -%}
          <h1 class="mahando-rp__title">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="mahando-rp__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      {%- if count > 0 -%}
        <div class="mahando-rp__summary">
          <div class="mahando-rp__score">
            <span class="mahando-rp__score-value">{{ rating | round: 1 | replace: '.', ',' }}</span>
            <span class="mahando-rp__score-max">von 5</span>
          </div>
          {% render 'mahando-stars', rating: rating, size: 22 %}
          <p class="mahando-rp__count">Basierend auf {{ count }} {% if count == 1 %}Bewertung{% else %}Bewertungen{% endif %}</p>

          {%- if reviews.size > 0 -%}
            <ul class="mahando-rp__bars" role="list">
              {%- for star in (1..5) reversed -%}
                {%- assign n = 0 -%}
                {%- for rev in reviews -%}
                  {%- if rev.rating == star -%}{%- assign n = n | plus: 1 -%}{%- endif -%}
                {%- endfor -%}
                {%- assign pct = n | times: 100 | divided_by: reviews.size -%}
                <li class="mahando-rp__bar">
                  <span class="mahando-rp__bar-label">{{ star }} ★</span>
                  <span class="mahando-rp__bar-track"><span style="width: {{ pct }}%"></span></span>
                  <span class="mahando-rp__bar-n">{{ n }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endif -%}
    </header>

    {%- if reviews.size > 0 -%}
      <ul class="mahando-rp__list" role="list">
        {%- for rev in reviews -%}
          <li class="mahando-rp__card">
            <div class="mahando-rp__card-top">
              {% render 'mahando-stars', rating: rev.rating, size: 16 %}
              <time class="mahando-rp__date" datetime="{{ rev.created_at }}">{{ rev.created_at | date: '%d.%m.%Y' }}</time>
            </div>
            {%- if rev.title != blank -%}
              <p class="mahando-rp__card-title">{{ rev.title | escape }}</p>
            {%- endif -%}
            <div class="mahando-rp__body">{{ rev.body | escape | newline_to_br }}</div>
            <div class="mahando-rp__meta">
              <span class="mahando-rp__name">{{ rev.reviewer_name | escape }}</span>
              {%- if rev.verified_buyer -%}
                <span class="mahando-rp__verified">Verifizierter Kauf</span>
              {%- endif -%}
            </div>
            <p class="mahando-rp__about">
              {%- if rev.is_shop_review -%}
                Bewertung des Shops
              {%- else -%}
                Bewertung zu: {{ rev.product_title | escape }}
              {%- endif -%}
            </p>
            {%- if rev.reply_content != blank -%}
              <div class="mahando-rp__reply"><strong>Antwort von Mahando:</strong> {{ rev.reply_content | strip_html | escape }}</div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="mahando-rp__empty">Es liegen noch keine Bewertungen vor.</p>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <div class="mahando-rp__note rte">{{ section.settings.note }}</div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .mahando-rp {
    display: grid;
    gap: 28px;
  }

  .mahando-rp__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 340px);
    gap: 24px 40px;
    align-items: start;
  }

  .mahando-rp__title {
    margin: 0 0 10px;
  }

  .mahando-rp__text {
    max-width: 62ch;
    font-size: var(--font-size--sm);
  }

  .mahando-rp__text p:last-child {
    margin-bottom: 0;
  }

  .mahando-rp__summary {
    background: var(--mahando-surface, #fff);
    border: 1px solid rgb(29 43 51 / 0.1);
    border-radius: 12px;
    padding: 20px 22px;
    display: grid;
    gap: 8px;
  }

  .mahando-rp__score {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .mahando-rp__score-value {
    font-family: var(--font-heading--family);
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1;
  }

  .mahando-rp__score-max,
  .mahando-rp__count {
    font-size: var(--font-size--sm);
    opacity: 0.75;
    margin: 0;
  }

  .mahando-rp__bars {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    display: grid;
    gap: 5px;
    font-size: var(--font-size--xs);
  }

  .mahando-rp__bar {
    display: grid;
    grid-template-columns: 34px 1fr 24px;
    align-items: center;
    gap: 8px;
  }

  .mahando-rp__bar-track {
    height: 8px;
    border-radius: 4px;
    background: #e6ecef;
    overflow: hidden;
  }

  .mahando-rp__bar-track span {
    display: block;
    height: 100%;
    background: #e8a317;
  }

  .mahando-rp__bar-n {
    text-align: end;
    opacity: 0.75;
  }

  .mahando-rp__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .mahando-rp__card {
    background: var(--mahando-surface, #fff);
    border: 1px solid rgb(29 43 51 / 0.1);
    border-radius: 12px;
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: var(--font-size--sm);
  }

  .mahando-rp__card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .mahando-rp__date,
  .mahando-rp__about {
    font-size: var(--font-size--xs);
    opacity: 0.65;
    margin: 0;
  }

  .mahando-rp__card-title {
    font-weight: 700;
    margin: 0;
  }

  .mahando-rp__body {
    flex: 1;
  }

  .mahando-rp__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-size: var(--font-size--xs);
  }

  .mahando-rp__name {
    font-weight: 600;
  }

  .mahando-rp__verified {
    color: #1f7a4d;
    background: #e7f5ee;
    border-radius: 999px;
    padding: 2px 8px;
    font-weight: 600;
  }

  .mahando-rp__reply {
    background: #f2f6f8;
    border-radius: 8px;
    padding: 10px 12px;
    font-size: var(--font-size--xs);
  }

  .mahando-rp__note {
    font-size: var(--font-size--xs);
    opacity: 0.7;
    max-width: 80ch;
  }

  @media screen and (max-width: 989px) {
    .mahando-rp__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .mahando-rp__head {
      grid-template-columns: 1fr;
    }

    .mahando-rp__list {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bewertungen (Mahando)",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Kundenbewertungen"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Einleitung",
      "default": "<p>Hier finden Sie alle Bewertungen, die Kundinnen und Kunden zu ihren Bestellungen bei Mahando abgegeben haben.</p>"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Hinweis unter den Bewertungen",
      "default": "<p>Die Bewertungen werden über Judge.me gesammelt. Bewertungen mit dem Hinweis „Verifizierter Kauf“ stammen von Kundinnen und Kunden mit nachgewiesener Bestellung.</p>"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Bewertungen (Mahando)"
    }
  ]
}
{% endschema %}
