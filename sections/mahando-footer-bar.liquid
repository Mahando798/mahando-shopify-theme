{%- comment -%}
  Footer-Leiste mit Zahlungsarten (Icons aus shop.enabled_payment_types), Preis-/MwSt.-Hinweis
  und optionalem Badge-Code (z. B. idealo-Bewertungs-Badge).
{%- endcomment -%}

{% render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="mahando-footer-bar section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="--mahando-footer-divider: {{ section.settings.divider_color | default: 'rgb(255 255 255 / 0.12)' }};"
>
  <div class="mahando-footer-bar__inner">
    {%- if section.settings.show_payment_icons -%}
      <div class="mahando-footer-bar__payments">
        {%- if section.settings.payment_label != blank -%}
          <span class="mahando-footer-bar__label">{{ section.settings.payment_label }}</span>
        {%- endif -%}
        <ul class="mahando-footer-bar__icons" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
    {%- if section.settings.badge_html != blank -%}
      <div class="mahando-footer-bar__badge">{{ section.settings.badge_html }}</div>
    {%- endif -%}
    {%- if section.settings.show_withdraw -%}
      {%- comment -%}
        Widerrufsbutton nach § 356a BGB: Link mit #widerrufsbutton öffnet das Formular der App „EU Widerrufsbutton“
        (App-Einbettung „Widerrufsbutton Embed“ muss aktiv sein). Ohne App führt der Link zur Widerrufsbelehrung.
      {%- endcomment -%}
      <div class="mahando-footer-bar__withdraw">
        <a class="mahando-withdraw-button" href="{{ section.settings.withdraw_url | default: '#widerrufsbutton' }}">{{ section.settings.withdraw_label | default: 'Vertrag widerrufen' }}</a>
        {%- if section.settings.withdraw_note != blank -%}
          <span class="mahando-footer-bar__withdraw-note">{{ section.settings.withdraw_note }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.settings.note != blank -%}
      <p class="mahando-footer-bar__note">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .mahando-footer-bar__inner {
    border-top: 1px solid var(--mahando-footer-divider);
    padding-block: 22px 6px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    font-size: var(--font-size--xs);
  }

  .mahando-footer-bar__payments {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .mahando-footer-bar__label {
    font-weight: 600;
    opacity: 0.8;
  }

  .mahando-footer-bar__icons {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .mahando-footer-bar__icons li {
    background: #fff;
    border-radius: 4px;
    line-height: 0;
    padding: 2px;
  }

  .mahando-footer-bar__icons svg {
    width: 38px;
    height: 24px;
  }

  .mahando-footer-bar__badge {
    display: flex;
    align-items: center;
  }

  .mahando-footer-bar__note {
    margin: 0;
    flex-basis: 100%;
    opacity: 0.8;
  }

  .mahando-footer-bar__withdraw {
    margin-inline-start: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }

  /* Eigene Optik behalten, auch wenn die App ihre !important-Styles nachlädt (höhere Spezifität) */
  .mahando-footer-bar a.mahando-withdraw-button,
  .mahando-footer-bar a.mahando-withdraw-button[href$='#widerrufsbutton'] {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 22px !important;
    border-radius: 8px !important;
    border: 2px solid #fff !important;
    background-color: transparent !important;
    color: #fff !important;
    font-family: var(--font-heading--family);
    font-weight: 700 !important;
    font-size: var(--font-size--sm) !important;
    letter-spacing: 0.01em;
    text-decoration: none !important;
    box-shadow: none !important;
    margin: 0 !important;
    cursor: pointer;
  }

  .mahando-footer-bar a.mahando-withdraw-button:hover,
  .mahando-footer-bar a.mahando-withdraw-button:focus-visible {
    background-color: #fff !important;
    color: #1d2b33 !important;
  }

  .mahando-footer-bar__withdraw-note {
    opacity: 0.8;
    text-align: end;
  }

  @media screen and (max-width: 749px) {
    .mahando-footer-bar__withdraw {
      margin-inline-start: 0;
      align-items: flex-start;
      flex-basis: 100%;
    }

    .mahando-footer-bar__withdraw-note {
      text-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Zahlungsarten & Hinweis",
  "class": "section-wrapper",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Zahlungsarten anzeigen",
      "info": "Icons der im Shop aktivierten Zahlungsarten.",
      "default": true
    },
    {
      "type": "text",
      "id": "payment_label",
      "label": "Beschriftung",
      "default": "Zahlungsarten"
    },
    {
      "type": "liquid",
      "id": "badge_html",
      "label": "Badge-Code (optional)",
      "info": "z. B. das idealo-Bewertungs-Badge oder ein Trusted-Shops-Siegel."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Hinweiszeile",
      "default": "Alle Preise inkl. gesetzlicher MwSt., zzgl. Versandkosten."
    },
    {
      "type": "header",
      "content": "Widerrufsbutton (§ 356a BGB)"
    },
    {
      "type": "checkbox",
      "id": "show_withdraw",
      "label": "Button „Vertrag widerrufen“ anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "withdraw_label",
      "label": "Beschriftung",
      "default": "Vertrag widerrufen"
    },
    {
      "type": "text",
      "id": "withdraw_url",
      "label": "Ziel",
      "info": "#widerrufsbutton öffnet das Formular der App „EU Widerrufsbutton“.",
      "default": "#widerrufsbutton"
    },
    {
      "type": "text",
      "id": "withdraw_note",
      "label": "Hinweis unter dem Button",
      "default": "Widerruf innerhalb von 14 Tagen – Formular öffnet sich direkt"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text",
      "default": "#C9D5DB"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Trennlinie",
      "default": "#3B4B54"
    }
  ],
  "presets": [
    {
      "name": "Zahlungsarten & Hinweis",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
