{%- comment -%}
  Icon-Karten in zwei Stilen:
  - "compact": kleine Kacheln mit Icon, Titel und Untertitel (Vertrauensleiste unter dem Hero)
  - "card": größere Karten mit Icon, Überschrift und Absatz ("Warum Mahando")
{%- endcomment -%}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="section section--page-width color-custom-{{ section.id }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
    <div class="mahando-section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="mahando-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
  {%- endif -%}

  <div class="mahando-icon-cards mahando-icon-cards--{{ section.settings.style }} mahando-icon-cards--cols-{{ section.settings.columns }}">
    {%- for block in section.blocks -%}
      <div class="mahando-icon-card" {{ block.shopify_attributes }}>
        <span class="mahando-icon-card__icon">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}
          {%- else -%}
            {% render 'mahando-icon', icon: block.settings.icon %}
          {%- endif -%}
        </span>
        <span class="mahando-icon-card__body">
          {%- if block.settings.heading != blank -%}
            <strong class="mahando-icon-card__heading">{{ block.settings.heading }}</strong>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <span class="mahando-icon-card__text">{{ block.settings.text }}</span>
          {%- endif -%}
        </span>
      </div>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .mahando-icon-cards {
    display: grid;
    gap: 14px;
  }

  .mahando-icon-cards--cols-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .mahando-icon-cards--cols-4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .mahando-icon-card {
    display: flex;
    gap: 12px;
    align-items: center;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 14px 16px;
    min-width: 0;
  }

  .mahando-icon-card__icon {
    flex: none;
    display: grid;
    place-items: center;
    color: var(--color-foreground-subdued);
  }

  .mahando-icon-card__icon .mahando-icon,
  .mahando-icon-card__icon img {
    width: 26px;
    height: 26px;
  }

  .mahando-icon-card__body {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .mahando-icon-card__heading {
    font-size: var(--font-size--sm);
    font-weight: 600;
  }

  .mahando-icon-card__text {
    font-size: var(--font-size--xs);
    color: var(--color-foreground-muted);
  }

  /* Karten-Stil */
  .mahando-icon-cards--card {
    gap: 18px;
  }

  .mahando-icon-cards--card .mahando-icon-card {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 24px;
    border-radius: 12px;
  }

  .mahando-icon-cards--card .mahando-icon-card__icon .mahando-icon {
    width: 28px;
    height: 28px;
  }

  .mahando-icon-cards--card .mahando-icon-card__heading {
    font-family: var(--font-heading--family);
    font-size: var(--font-size--lg);
    line-height: 1.2;
  }

  .mahando-icon-cards--card .mahando-icon-card__text {
    font-size: var(--font-size--sm);
    line-height: 1.5;
  }

  @media screen and (max-width: 989px) {
    .mahando-icon-cards--cols-4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mahando-icon-cards--cols-3 {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .mahando-icon-cards--compact {
      gap: 8px;
    }

    .mahando-icon-cards--compact .mahando-icon-card {
      padding: 10px 12px;
      gap: 8px;
    }

    .mahando-icon-cards--compact .mahando-icon-card__icon .mahando-icon {
      width: 22px;
      height: 22px;
    }

    .mahando-icon-cards--compact .mahando-icon-card__text {
      display: none;
    }

    .mahando-icon-cards--card {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Icon-Karten (Mahando)",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Stil",
      "options": [
        { "value": "compact", "label": "Kompakt (Vertrauensleiste)" },
        { "value": "card", "label": "Karten mit Text" }
      ],
      "default": "compact"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Spalten (Desktop)",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleine Zeile über der Überschrift"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 18
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Karte",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Lieferwagen" },
            { "value": "box", "label": "Paket" },
            { "value": "shield", "label": "Schild (Sicherheit)" },
            { "value": "undo", "label": "Rückgabe" },
            { "value": "headset", "label": "Service" },
            { "value": "check", "label": "Haken" },
            { "value": "clock", "label": "Uhr" },
            { "value": "tag", "label": "Preisschild" },
            { "value": "star", "label": "Stern" },
            { "value": "mail", "label": "E-Mail" },
            { "value": "heart", "label": "Herz" }
          ],
          "default": "check"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Eigenes Icon (optional, ersetzt das Icon)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Überschrift",
          "default": "Versand aus Deutschland"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Ab Lager, 1–3 Werktage"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vertrauensleiste (Mahando)",
      "category": "t:categories.storytelling",
      "settings": { "style": "compact", "columns": "4" },
      "blocks": [
        { "type": "card", "settings": { "icon": "truck", "heading": "Versand aus Deutschland", "text": "Ab Lager, 1–3 Werktage" } },
        { "type": "card", "settings": { "icon": "box", "heading": "Versand 4,99 € pauschal", "text": "Ab 300 € Bestellwert kostenlos" } },
        { "type": "card", "settings": { "icon": "shield", "heading": "Sichere Zahlung", "text": "PayPal, Klarna, Karte, Rechnung" } },
        { "type": "card", "settings": { "icon": "headset", "heading": "Persönlicher Service", "text": "Telefon & E-Mail, Mo–Fr 8–15 Uhr" } }
      ]
    },
    {
      "name": "Warum Mahando (Mahando)",
      "category": "t:categories.storytelling",
      "settings": { "style": "card", "columns": "3", "eyebrow": "Warum Mahando", "heading": "Warum bei uns kaufen", "padding-block-start": 24, "padding-block-end": 48 },
      "blocks": [
        { "type": "card", "settings": { "icon": "box", "heading": "Ware liegt bei uns", "text": "Alle Artikel befinden sich in unserem Lager in Deutschland. Bestellungen an Werktagen werden in der Regel am nächsten Werktag versendet." } },
        { "type": "card", "settings": { "icon": "check", "heading": "Ehrliche Zustandsangabe", "text": "Standard ist Neuware in Originalverpackung. Reduzierte Artikel im Sale sind entsprechend gekennzeichnet: Auslaufmodell, beschädigte Verpackung oder B-Ware." } },
        { "type": "card", "settings": { "icon": "headset", "heading": "Persönlicher Service", "text": "Mo–Fr 8–15 Uhr per Telefon und E-Mail. Rücksendungen melden Sie über das Formular im Kundenkonto an." } }
      ]
    }
  ]
}
{% endschema %}
